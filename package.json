{
  "name": "thunder-fantasy-desktop",
  "productName": "Thunder Fantasy",
  "version": "2.0.6",
  "description": "独立的雷霆比分与 Yahoo Fantasy 联盟分析桌面应用",
  "author": "Thunder Fantasy contributors",
  "license": "UNLICENSED",
  "private": true,
  "main": "app/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "dist:mac": "electron-builder --mac dmg zip --arm64 --x64",
    "dist:win": "electron-builder --win nsis zip --x64",
    "smoke": "electron . --smoke-test"
  },
  "dependencies": {
    "exceljs": "4.4.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "resedit": "3.1.0"
  },
  "build": {
    "appId": "app.thunderfantasy.desktop",
    "artifactName": "ThunderFantasy-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "app/**",
      "core/**",
      "assets/**",
      "package.json"
    ],
    "asar": true,
    "afterPack": "scripts/windows-branding.cjs",
    "mac": {
      "category": "public.app-category.sports",
      "icon": "assets/Thunder.icns",
      "identity": "-"
    },
    "dmg": {
      "title": "Thunder Fantasy 安装",
      "sign": false
    },
    "win": {
      "signAndEditExecutable": false,
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true
    }
  }
}
